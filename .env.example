# Database (SQLite - 별도 설치 불필요)
DATABASE_URL=sqlite:///./scholarios.db

# Application Settings
APP_NAME=ScholarOS
DEBUG=False
ALLOWED_ORIGINS=["http://localhost:8000"]

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Timezone
TIMEZONE=Asia/Seoul

# Authentication
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Director Account (서버 첫 실행 시 자동 생성)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin1234
INITIAL_ADMIN_NAME=원장
